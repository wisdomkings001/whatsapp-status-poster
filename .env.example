# Copy this file to .env and fill in real values. Never commit .env.

# Port the admin panel / server listens on
PORT=3000

# Admin login (used for the web panel, not WhatsApp)
ADMIN_USERNAME=admin
# Generate a hash with: node scripts/hash-password.js yourPasswordHere
ADMIN_PASSWORD_HASH=

# Long random string used to sign the admin session cookie
SESSION_SECRET=change_this_to_a_long_random_string

# Default posting window for the fixed daily opener (24h format, server local time)
OPENER_WINDOW_START=07:00
OPENER_WINDOW_END=08:00

# Default interval range (minutes) between regular posts
MIN_INTERVAL_MINUTES=30
MAX_INTERVAL_MINUTES=90

# Default daily quota range (regular posts, excludes the opener)
MIN_DAILY_QUOTA=6
MAX_DAILY_QUOTA=12

# Cooldown before a product can repeat (hours)
COOLDOWN_HOURS=48

# Only needed on Termux/Android or other environments where Puppeteer's own
# Chromium download won't run. Point this at a system-installed Chromium instead.
# Example for Termux + proot-distro Debian: /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=
